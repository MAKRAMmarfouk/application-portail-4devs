# Server Port
PORT=5000
NODE_ENV=development

# Database URL
# Pour SQLite (développement local sans serveur de base de données externe) :
DATABASE_URL="file:./dev.db"
# Pour PostgreSQL (production ou docker) :
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecoles_db?schema=public"

# Auth Secrets
JWT_SECRET="remplacer-par-une-cle-secrete-aleatoire-et-robuste"
JWT_EXPIRES_IN="7d"

# Frontend Origin for CORS
CORS_ORIGIN="http://localhost:5173"
